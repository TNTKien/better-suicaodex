# Runtime
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Additional exact origins trusted by CORS, Better Auth and CSRF checks.
# WEB_ORIGIN remains the primary origin for redirects and is always included.
WEB_ALLOWED_ORIGINS=http://localhost:3002

# PostgreSQL
# Use separate development and disposable test databases.
DATABASE_URL=postgresql://user:password@host/scd_dev?sslmode=verify-full
TEST_DATABASE_URL=postgresql://user:password@host/scd_test?sslmode=verify-full

# Better Auth
# Generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# Development OAuth
# Discord redirect URL: http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Optional group-creation review alert. Leave both blank to disable.
# Secret URL created in the destination Discord text channel; do not commit it.
DISCORD_GROUP_REVIEW_WEBHOOK_URL=
# Discord user ID to ping (Developer Mode > Copy User ID), not username or role ID.
DISCORD_GROUP_REVIEW_MENTION_USER_ID=

# Production OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional credential for allowlisted public reads from the Next.js server.
# Generate one random value of at least 32 bytes and configure the same value in apps/web.
# INTERNAL_API_KEY=
INTERNAL_API_RATE_LIMIT_PER_SECOND=100
# Exact IPs of reverse proxies allowed to supply forwarded client-IP headers.
TRUSTED_PROXY_IPS=

# Redis business cache
# Redis is optional in development. REDIS_URL is required when this is true.
REDIS_CACHE_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/0
# Remote providers such as Upstash must use rediss:// (TLS).
# REDIS_URL=rediss://default:password@example.upstash.io:6379
REDIS_PREFIX=redive:development
REDIS_DEFAULT_TTL_SECONDS=30
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RECONNECT_RETRY_MS=15000
REDIS_CACHE_VERSION_REFRESH_MS=1500

# Endpoint cache TTLs in seconds
ENDPOINT_CACHE_HOMEPAGE_TTL_SECONDS=45
ENDPOINT_CACHE_MANGA_LIST_TTL_SECONDS=180
ENDPOINT_CACHE_MANGA_DETAIL_TTL_SECONDS=300
ENDPOINT_CACHE_CHAPTER_DETAIL_TTL_SECONDS=450
ENDPOINT_CACHE_MANGA_ROUTE_LOOKUP_TTL_SECONDS=300
ENDPOINT_CACHE_MANGA_RANKING_TTL_SECONDS=90

# Public cover and chapter assets
ASSET_BASE_URL=http://localhost:9000/
HIDE_R18=true
HIDDEN_MANGA_IDS=
HIDDEN_CHAPTER_IDS=

# SuicaoCoin rewards/private wallet routes. Enable after configuring the wallet and reward policy.
COIN_ENABLED=false
# Exact group IDs for re-up/uploader groups. System is always excluded.
COIN_EXCLUDED_GROUP_IDS=
# Independent Shop gate. New purchases also require coin and avatar frames enabled.
SHOP_ENABLED=false
# Independent normal-chest gate; new rolls also require coin/Shop/avatar frames.
GACHA_ENABLED=false
# Shop catalog/stock CLI only; optional direct PostgreSQL target, never an asset source URL.
# SHOP_MAINTENANCE_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database

# Independent avatar decorations; off retains ownership/selection but renders none.
# Admin catalog/grants remain available to prepare assets; equip requires true.
AVATAR_FRAMES_ENABLED=false

# TikTok secondary chapter images: keep disabled unless configured.
IMAGE_SERVER2_ENABLED=false
IMAGE_SERVER2_UPLOAD_ENABLED=false
IMAGE_SERVER2_READ_ENABLED=false
# Worker process only; never expose these through NEXT_PUBLIC_* or CLI arguments.
# TIKTOK_COOKIE=
# TIKTOK_CSRF_TOKEN=

# S3-compatible storage. Runtime upload is enabled when S3_STAGING_BUCKET is set;
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_STAGING_BUCKET=
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=
