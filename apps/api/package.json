{
  "name": "api",
  "type": "module",
  "scripts": {
    "admin:create": "bun src/scripts/admin-create.ts",
    "admin:access": "bun src/scripts/admin-access.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "test": "bun test ./test/unit",
    "test:integration": "bun --no-env-file src/scripts/test-integration.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config ./src/db/auth.config.ts --output ./src/db/auth-schema.ts --adapter drizzle --dialect postgresql --yes && prettier --write ./src/db/auth-schema.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:check": "drizzle-kit check --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "shop:catalog": "node --env-file=.env --import tsx src/scripts/shop-catalog.ts",
    "storage:cleanup-covers": "bun src/scripts/cover-cleanup.ts",
    "storage:cleanup-chapters": "bun src/scripts/chapter-cleanup.ts",
    "image-server2": "bun src/scripts/image-server2.ts",
    "image-server2:worker": "node --env-file=.env dist/scripts/image-server2-worker.js",
    "contract:generate": "bun src/scripts/contract.ts",
    "contract:check": "bun src/scripts/contract.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@date-fns/tz": "1.5.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@scalar/hono-api-reference": "0.12.0",
    "better-auth": "1.7.2",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@workspace/eslint-config": "workspace:^",
    "auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
